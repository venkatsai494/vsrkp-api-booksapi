meta {
  name: Authentication copy
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api-clients
  body: json
  auth: inherit
}

body:json {
  {
     "clientName": "Tester Human",
     "clientEmail": "test@mail.com"
  }
}

assert {
  res.status: eq 409
  res.body.error: eq API client already registered. Try a different email.
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

docs {
  <br/>
}
