meta {
  name: bookById
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/books/{{availableBookId}}
  body: none
  auth: inherit
}

vars:pre-request {
  bookId: 3
}

assert {
  res.status: eq 200
  res.body.id: eq 5
  res.body.PK: eq BOOK#{{availableBookId}}
  res.body.GSI1SK: contains {{availableBookId}}
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
