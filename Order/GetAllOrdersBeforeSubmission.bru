meta {
  name: GetAllOrdersBeforeSubmission
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  This request retrieves all the submitted order details. This request uses the access token which was generated in the Authentication request as a bearer token for authentication
}
