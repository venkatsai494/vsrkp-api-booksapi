meta {
  name: listOfBooks
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/books
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  Object.keys(res.body): length 6
}

script:post-response {
  const books = res.getBody();
  
  const availableBooks = books.filter(book => book.available === true);
  const unAvailableBooks = books.filter(book => book.available === false);
  
  if (availableBooks.length > 0) {
    const availableRandomBook = availableBooks[
      Math.floor(Math.random() * availableBooks.length)
    ];
  
    bru.setEnvVar("availableBookId", availableRandomBook.id);
    bru.setEnvVar("availableBookName", availableRandomBook.name);
  }
  
  if (unAvailableBooks.length > 0) {
    const unAvailableRandomBook = unAvailableBooks[
      Math.floor(Math.random() * unAvailableBooks.length)
    ];
  
    bru.setEnvVar("unAvailableBookId", unAvailableRandomBook.id);
    bru.setEnvVar("unAvailableBookName", unAvailableRandomBook.name);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  This request retrieves the list of all the books. This request uses the access token which was generated in the Authentication request as a bearer token for authentication.
  
  \
  Script:
  
  We would be taking any two random books one which is available and one which is unavailable which would be stored as environment variable so that they can be used in subsequent requests
  
  <br/>
  
  Assertions:
  
  - We are asserting the request with http status code as 200
  - Number of objects or books present in the response json using Object.keys(res.body)
}
