meta {
  name: listOfBooks
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/books
  body: none
  auth: inherit
}

script:post-response {
  const books = res.getBody();
  
  const availableBooks = books.filter(book => book.available === true);
  const unAvailableBooks = books.filter(book => book.available === false);
  
  if (availableBooks.length > 0) {
    const availableRandomBook = availableBooks[
      Math.floor(Math.random() * availableBooks.length)
    ];
  
    bru.setEnvVar("availableBookId", availableRandomBook.id);
    bru.setEnvVar("availableBookName", availableRandomBook.name);
  }
  
  if (unAvailableBooks.length > 0) {
    const unAvailableRandomBook = unAvailableBooks[
      Math.floor(Math.random() * unAvailableBooks.length)
    ];
  
    bru.setEnvVar("unAvailableBookId", unAvailableRandomBook.id);
    bru.setEnvVar("unAvailableBookName", unAvailableRandomBook.name);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  I am using the documentation of https://github.com/vdespa/introduction-to-postman-course/blob/main/simple-books-api.md
}
