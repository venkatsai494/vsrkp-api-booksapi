meta {
  name: OrderUnavailableBook
  type: http
  seq: 5
}

post {
  url: {{BASE_URL}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "bookId": {{unAvailableBookId}},
    "customerName": "{{$randomFullName}}"
  }
}

assert {
  res.status: eq 404
  res.body.error: eq "This book is not in stock. Try again later."
}

settings {
  encodeUrl: true
  timeout: 0
}
