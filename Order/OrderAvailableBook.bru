meta {
  name: OrderAvailableBook
  type: http
  seq: 4
}

post {
  url: {{BASE_URL}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "bookId": {{availableBookId}},
    "customerName": "{{$randomFullName}}"
  }
}

vars:post-response {
  orderId: res.body.orderId
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
