meta {
  name: Authentication
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api-clients
  body: json
  auth: inherit
}

body:json {
  {
     "clientName": "Postman_{{randomString}}",
     "clientEmail": "test_{{randomString}}@example.com"
  }
}

vars:post-response {
  token: res.body.accessToken
}

script:pre-request {
  const randomStr = Date.now() + '_' + Math.random.toString(36).substring(2,6);
  bru.setEnvVar("randomString", randomStr);
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

docs {
  Use this request in case of Order related APIs are throwing 401 Unauthorized errors
}
