meta {
  name: Authentication
  type: http
  seq: 5
}

post {
  url: {{BASE_URL}}/api-clients
  body: json
  auth: inherit
}

body:json {
  {
     "clientName": "Postman_{{randomString}}",
     "clientEmail": "test_{{randomString}}@example.com"
  }
}

script:pre-request {
  const randomStr = Date.now() + '_' + Math.random.toString(36).substring(2,6);
  bru.setEnvVar("randomString", randomStr);
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
